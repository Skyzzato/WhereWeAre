sdk.dir=C\:/Users/YOUR_USER/AppData/Local/Android/Sdk
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# OpenTopoMap and CyclOSM are built in; no additional key or URL is required.
# Optional Firebase public Android configuration; leave empty until a project exists.
FIREBASE_APP_ID=
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_SENDER_ID=
# Optional real HTTPS origin/path; blank means invitations share only the code.
# Requires a published fallback page and /.well-known/assetlinks.json before enabling.
INVITE_BASE_URL=

# Approved production Valhalla route endpoint only. Empty disables routing.
# Do not place provider secrets in this client configuration. See ADR_ROUTING.md.
ROUTING_PROVIDER=
ROUTING_ENDPOINT=
